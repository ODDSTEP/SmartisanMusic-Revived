<?xml version="1.0" encoding="utf-8"?>
<!--
  [1.4.24·R40 自绘通知·收起态]
  用户反馈（实机）：「收起态小通知比其他正常的通知高度要高，但按钮小得跟鸡屁一样」
  → 本轮两处改动：
    ① 高度 48dp → 44dp，并去掉上下多余留白，与系统普通通知单行观感一致；
    ② 按钮图标改用 drawable-xxhdpi 的 notif_flat_*（24dp 视觉）。
       上一版这些 PNG 放在 drawable-nodpi（1px=1dp），96px 的图被当成 96dp
       再缩到 26dp 内容区，图形实际只剩 ~7dp —— 这就是「小得跟鸡屁一样」的根因；
       xxhdpi 是 3x，72px 正好 24dp，图形按原比例铺满。

  [1.4.24·R40] 新增「收藏」键（用户原话：「收起后的小通知……没位置放收藏键吗？」）：
  收藏状态用 notif_flat_favorite_add / notif_flat_favorite_cancel 两张图区分。

  封面不放这里 —— 展开态的封面已经交给系统 large icon 承载（见 ChuiziCustomNotificationProvider），
  系统装饰头会自己画通知图标，这里再画一张就重复了（用户原话：
  「怎么又显示专辑封面，又显示通知图标的？」）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="12dp"
    android:paddingRight="6dp">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/notif_text_primary" />

    <!-- [1.4.26] 收起态同样换 24dp 矢量（padding = (容器 - 24) / 2）。 -->
    <ImageView
        android:id="@+id/notif_btn_favorite"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/notif_vec_favorite"
        android:contentDescription="@string/notification_action_favorite" />

    <ImageView
        android:id="@+id/notif_btn_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/notif_vec_prev"
        android:contentDescription="@string/previous_song" />

    <ImageView
        android:id="@+id/notif_btn_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/notif_vec_play"
        android:contentDescription="@string/play" />

    <ImageView
        android:id="@+id/notif_btn_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/notif_vec_next"
        android:contentDescription="@string/next_song" />
</LinearLayout>
