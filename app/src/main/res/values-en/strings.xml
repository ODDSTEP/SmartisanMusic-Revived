    <!-- ===== 1.4.20 P0/P1/P2 audio effects ===== -->
    <string name="eq_section_effects">Audio Enhancements</string>
    <string name="fx_playpause_fade">Play/Pause Fade</string>
    <string name="fx_playpause_fade_on">On: smooth fade-in on start and fade-out on pause, avoiding clicks.</string>
    <string name="fx_playpause_fade_off">Off: immediate play/pause switching.</string>
    <string name="fx_compressor">Compressor</string>
    <string name="fx_compressor_on">On: tames dynamics and prevents clipping for a steadier sound.</string>
    <string name="fx_compressor_off">Off: keeps original dynamics.</string>
    <string name="fx_compressor_strength">Compression Strength</string>
    <string name="fx_compressor_strength_value">%1$d%%</string>
    <string name="fx_concert_hall">Concert Hall</string>
    <string name="fx_concert_hall_on">On: adds a wider, longer hall reverb.</string>
    <string name="fx_concert_hall_off">Off: no concert hall effect.</string>
    <string name="fx_v3_reverb">V3 Enhanced Reverb</string>
    <string name="fx_v3_reverb_on">On: enhanced reverb with multiple early reflections and a long tail.</string>
    <string name="fx_v3_reverb_off">Off: basic reverb only.</string>
    <string name="fx_channel_balance">Channel Balance</string>
    <string name="fx_channel_balance_value">%1$s</string>
    <string name="fx_channel_balance_center">Center</string>
    <string name="fx_channel_balance_left">Left %1$d%%</string>
    <string name="fx_channel_balance_right">Right %1$d%%</string>
    <string name="fx_replaygain">ReplayGain Loudness</string>
    <string name="fx_replaygain_on">On: reads ReplayGain tags to even out loudness across tracks.</string>
    <string name="fx_replaygain_off">Off: tracks play at their original loudness.</string>
    <string name="fx_replaygain_gain">Target Gain</string>
    <string name="fx_replaygain_gain_value">%1$+d dB</string>
    <string name="fx_replaygain_fallback">Normalize Tracks Without Tags</string>
    <string name="fx_replaygain_fallback_on">On: normalize loudness even for tracks without ReplayGain tags.</string>
    <string name="fx_replaygain_fallback_off">Off: keep original loudness for untagged tracks.</string>
    <string name="fx_gain_meter">Gain Meter</string>
    <string name="fx_gain_meter_on">On: show live peak, headroom and clipped-sample count in the Audio Output panel.</string>
    <string name="fx_gain_meter_off">Off: hide the live level meter.</string>
    <string name="fx_reverse">Reverse Playback</string>
    <string name="fx_reverse_on">On: play the current track backwards.</string>
    <string name="fx_reverse_off">Off: normal playback order.</string>
    <string name="fx_varispeed">Variable Speed</string>
    <string name="fx_varispeed_on">On: play at the speed set below without changing pitch.</string>
    <string name="fx_varispeed_off">Off: play at original speed.</string>
    <string name="fx_speed">Playback Speed</string>
    <string name="fx_speed_value">%1$.2fx</string>
    <string name="fx_bass_dsp">BASS Audio Engine</string>
    <string name="fx_bass_dsp_on">On: EQ/reverb/compression processed by BASS_FX (better quality). Turn off to fall back to the in-house DSP.</string>
    <string name="fx_bass_dsp_off">Off: use the in-house DSP for effects.</string>
    <!-- 1.4.21 P2: smooth volume handoff + readback -->
    <string name="fx_smooth_volume">Smooth Volume Handoff</string>
    <string name="fx_smooth_volume_on">On: smoothly ramps volume when dragging the slider or pressing volume keys, removing jumps/pops, and reads back to confirm it took effect.</string>
    <string name="fx_smooth_volume_off">Off: volume changes instantly (legacy behavior).</string>
    <string name="gain_vol_handoff">Volume handoff</string>
    <string name="gain_vol_handoff_value">target %1$d%% → actual %2$d%% (%3$s)</string>
    <string name="gain_vol_handoff_ok">readback OK</string>
    <string name="gain_vol_handoff_pending">ramping</string>
    <string name="gain_vol_handoff_na">not active</string>
    <string name="gain_peak">Peak</string>
    <string name="gain_headroom">Headroom</string>
    <string name="gain_rms">RMS Level</string>
    <string name="gain_clipped">Clipped Samples</string>
    <string name="gain_clipped_value">%1$d</string>
    <string name="gain_no_signal">No signal</string>
    <string name="smart_crossfade_morvanium_note">When on, smart transition uses the Morvanium strategy (beat/energy analysis) for a true equal-power crossfade at the end of a track; skipping manually uses a smooth fade in/out.</string>
    <string name="monet_m3_fixed_hint">Fixed in M3 palette</string>
    <string name="monet_deep_background">Deepen blank areas</string>
    <string name="monet_deep_background_hint">Turn on Monet colors and background first</string>
    <string name="sort_play_bar_swap">Swap sort bar and play bar</string>
    <string name="sort_play_bar_swap_desc_on">On: play bar on top, sort bar below.</string>
    <string name="sort_play_bar_swap_desc_off">Off: sort bar on top, play bar below (default).</string>
    <string name="text_marquee">Scroll long text</string>
    <string name="text_marquee_desc_on">On: long text scrolls; off: text is clipped.</string>
    <string name="text_marquee_desc_off">Off: long text is clipped with no ellipsis or scroll.</string>
