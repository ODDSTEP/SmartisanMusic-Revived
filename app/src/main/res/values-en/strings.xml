    <!-- 1.4.8 Appearance: immersive status bar switch -->
    <!-- 1.4.9 G-50: direct flavor perf-priority switch locked hint -->
    <string name="usb_exclusive_perf_priority_locked">Unavailable in direct-read mode</string>
    <!-- 1.4.19 S03: new open-source USB exclusive engine switch (off by default) -->
    <string name="usb_new_engine">New USB Exclusive Engine</string>
    <string name="usb_new_engine_desc_on">On: uses an open-source USB audio driver (libusb userspace, full DAC capability parsing, automatic sample-rate and bit-depth adaptation). Falls back to the old engine automatically if your DAC is incompatible.</string>
    <string name="usb_new_engine_desc_off">Off: uses the long-verified legacy exclusive engine. Turn this on to try the new engine and compare sound quality on your device.</string>
    <!-- 1.4.19 S07: smart crossfade -->
    <string name="smart_crossfade">Smart Crossfade</string>
    <string name="smart_crossfade_desc_on">On: the current song fades out and the next fades in on track change for a smoother transition.</string>
    <string name="smart_crossfade_desc_off">Off: track changes use the original direct cut.</string>
    <string name="smart_crossfade_duration">Crossfade Duration</string>
    <string name="smart_crossfade_duration_value">%1$d s</string>
    <string name="status_bar_immersive">Immersive status bar</string>
    <string name="status_bar_immersive_desc_on">On: the status bar keeps the same color as the title bar (immersive).</string>
    <string name="status_bar_immersive_desc_off">Off: the status bar turns black in the Android default style, with light icons.</string>
    <string name="status_bar_hidden">Hide status bar</string>
    <string name="status_bar_hidden_desc_on">On: the status bar is fully hidden for full screen; swipe down from the top to reveal it temporarily.</string>
    <string name="status_bar_hidden_desc_off">Off: the status bar shows normally.</string>
    <!-- [1.4.24·R36] Album play actions bar visibility -->
    <string name="album_play_bar_visible">Album play bar</string>
    <string name="album_play_bar_visible_desc_on">On: show the \"Play all / Shuffle\" bar at the top of the album page.</string>
    <string name="album_play_bar_visible_desc_off">Off: hide the bar so the album list moves up by one row.</string>
    <string name="notification_custom_layout">Large notification buttons</string>
    <string name="notification_custom_layout_desc_on">On: previous / play / next each take a third of the row for an easier tap target; the progress bar is read-only, tap the notification to seek in the app.</string>
    <string name="notification_custom_layout_desc_off">Off: use the system media card with 48dp buttons and a draggable progress bar.</string>
