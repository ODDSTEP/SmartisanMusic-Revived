    <string name="playback_engine">Playback engine</string>
    <string name="engine_official">Dual-path (recommended)</string>
    <string name="engine_official_summary">Zero-cache common formats; self-decode rare formats &amp; USB exclusive</string>
    <string name="engine_direct">System direct-read</string>
    <string name="engine_direct_summary">All formats zero-cache instant play, no equalizer / USB exclusive</string>
    <string name="engine_capability_note">Engine capabilities:\n· System direct-read — near-all formats play instantly with zero cache; the system MediaPlayer gives no decoded PCM, so USB exclusive, equalizer, reverb and float WAV are unavailable here (switches greyed out).\n· Dual-path official — common formats zero-cache direct, rare formats &amp; USB exclusive self-decoded; equalizer and all effects available.\n· Streaming decode — rare formats streamed without disk cache, equalizer and all effects available; seek stability pending device testing.\nSwitching engines rebuilds the player and restores the last song and position.</string>
    <string name="engine_stream">Streaming decode</string>
    <string name="engine_stream_summary">Rare formats streamed without disk cache, all effects kept</string>
    <string name="engine_restart_hint">Applies instantly</string>
    <string name="engine_restart_note">Applies instantly, restoring the last song and position.</string>

