    <!-- [v22] 音量模式（口径对齐 Salt Player：自动 / 数字音量 / DAC 硬件音量） -->
    <string name="usb_volume_mode_digital">数字音量</string>
    <string name="usb_volume_mode_dac">DAC 硬件音量</string>
    <string name="usb_volume_current">%1$s · %2$s</string>
    <string name="usb_volume_hw_supported">硬件可用</string>
    <string name="usb_volume_hw_unsupported">硬件不可用</string>
    <!-- [1.4.30·R170] 三态中间态：只读到描述符、没做过写入回读，不能说成"可用" -->
    <string name="usb_volume_hw_detected">检测到（未验证）</string>
    <string name="usb_volume_mode_zero_loss_hw_detected">零损失已开启：音量按 DAC 硬件音量走，但本机没验证过写入。若调音量无反应，会自动回落到数字音量（此时零损失失效）。</string>
    <string name="usb_volume_mode_hw_detected">检测到这台 DAC 带音量控制，但本机没有做写入回读验证，不确认调音量真能生效。实际是否生效以调音量时有无反应为准；一旦写失败会自动回落到数字音量。</string>
    <string name="usb_volume_mode_desc_auto">播放开始后检测 DAC：能调硬件音量就优先硬件（音频字节不动），否则用数字音量。</string>
    <string name="usb_volume_mode_desc_digital">把音量档位映射为 -60~0 dB 后在 PCM 上衰减，精度高、所有 DAC 可用，但会破坏 bit-perfect。</string>
    <string name="usb_volume_mode_desc_hardware">通过 USB 控制传输直接改 DAC 芯片内部音量；音频字节完全不动，可与零损失同时使用。部分 DAC 不支持。</string>
    <string name="usb_volume_mode_zero_loss_forced">零损失已开启：音量自动走 DAC 硬件音量，保证逐字节直传。</string>
    <string name="usb_volume_mode_zero_loss_no_hw">零损失已开启，但该 DAC 不支持硬件音量：请把音量拉到满档，否则会自动走普通路径（零损失失效）。</string>
    <string name="usb_volume_mode_hw_unsupported">该 DAC 不支持硬件音量：实际会走数字（软件）音量，调音量不会直接改 DAC 芯片。</string>
    <string name="usb_tpdf_dither">TPDF 抖动</string>
    <string name="usb_tpdf_dither_summary">数字衰减量化前加极低电平噪声</string>
    <string name="usb_tpdf_dither_desc_on">已开启：数字音量衰减后量化到目标位深前，加入 ±1 LSB 的三角分布噪声，把低音量下的截断失真换成听不见的白噪。</string>
    <string name="usb_tpdf_dither_desc_off">已关闭：数字衰减直接量化。高音量下差别很小，低音量时开启更干净。</string>
